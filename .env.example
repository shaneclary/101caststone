# Project inquiry form (/api/inquiry). Without RESEND_API_KEY and INQUIRY_FROM_EMAIL, the form hands the inquiry off to the visitor's email app.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Sender, which must be an address on a domain verified in Resend, e.g. "101 Cast Stone <inquiries@101caststone.com>"
INQUIRY_FROM_EMAIL=

# Optional: where inquiries are delivered. Defaults to info@101caststone.com
INQUIRY_TO_EMAIL=
